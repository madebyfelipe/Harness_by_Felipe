{
  "name": "central-desktop",
  "productName": "Central",
  "version": "0.1.0",
  "private": true,
  "description": "Central de Agentes — app de computador da Made by Felipe",
  "author": "Made by Felipe",
  "license": "UNLICENSED",
  "main": "main.mjs",
  "scripts": {
    "app": "electron .",
    "montar": "node build.mjs",
    "dist:win": "node build.mjs && electron-builder --win nsis --x64",
    "dist:linux": "node build.mjs && electron-builder --linux AppImage --x64",
    "dist:mac": "node build.mjs && electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "agency.madebyfelipe.central",
    "productName": "Central",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "icon.png",
      "servidor/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Central"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "icon.png"
    },
    "npmRebuild": false
  }
}
